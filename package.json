{
  "scripts": {
    "build": "node -e \"require('fs').cpSync('.', 'dist', {recursive: true, filter: (src) => !src.includes('node_modules') && !src.includes('android') && !src.includes('.git') && !src.includes('dist')})\"",
    "sync": "npm run build && npx cap copy android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
